# ── Secrets — never commit ────────────────────────────────────────────────
.env
.env.*
!.env.example

# ── Dependencies ──────────────────────────────────────────────────────────
/node_modules
/.pnp
.pnp.*

# ── Next.js / build output ────────────────────────────────────────────────
/.next/
/out/
/build
*.tsbuildinfo
# next-env.d.ts is committed (auto-generated but stable; keeps `tsc` happy in CI).

# ── Generated ─────────────────────────────────────────────────────────────
/src/generated/

# ── Local embedded PostgreSQL data (dev only) ─────────────────────────────
/.pgdata/
/.pgdata-*/

# ── Legacy-content migration workspace (extracted drafts + downloaded assets;
#    not application code — review artifacts only). Un-ignore if you want it
#    tracked for review.
/migration/

# ── Testing ───────────────────────────────────────────────────────────────
/coverage
/test-results
/playwright-report
/blob-report
/.playwright

# ── Tooling / OS / editor ─────────────────────────────────────────────────
.DS_Store
*.pem
*.swp
.idea/
.vscode/
.vercel

# ── Debug logs ────────────────────────────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Phase 9: locally-generated private documents (invoices / credit notes)
/.storage/

# Downloaded provider key exports — never commit
rzp-*.csv
*-key*.csv
*.key

# Design research — large reference captures (regenerate with design/research/_capture.mjs)
design/research/screenshots/
design/research/raw/

# Stray docs dropped in the repo root
/*.pdf
/*.docx
/Google Keep*
