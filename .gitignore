# ── Secrets — never commit ────────────────────────────────────────────────
.env
.env.*
!.env.example

# ── Dependencies ──────────────────────────────────────────────────────────
/node_modules
/.pnp
.pnp.*

# ── Next.js / build output ────────────────────────────────────────────────
/.next/
/out/
/build
*.tsbuildinfo
# next-env.d.ts is committed (auto-generated but stable; keeps `tsc` happy in CI).

# ── Generated ─────────────────────────────────────────────────────────────
/src/generated/

# ── Local embedded PostgreSQL data (dev only) ─────────────────────────────
/.pgdata/
/.pgdata-*/

# ── Testing ───────────────────────────────────────────────────────────────
/coverage
/test-results
/playwright-report
/blob-report
/.playwright

# ── Tooling / OS / editor ─────────────────────────────────────────────────
.DS_Store
*.pem
*.swp
.idea/
.vscode/
.vercel

# ── Debug logs ────────────────────────────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
