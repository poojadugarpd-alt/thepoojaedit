# ─── Site ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://your-domain.com
# Digits only, country code first. Drives every WhatsApp button.
NEXT_PUBLIC_WHATSAPP_NUMBER=919971572036

# ─── Instagram (optional — without it, content/instagram.json is used) ─
# Long-lived token from "Instagram API with Instagram Login" for the
# @poojadugar_ Business/Creator account. Expires every 60 days; see README.
INSTAGRAM_ACCESS_TOKEN=

# ─── YouTube (optional — without it, the public RSS feed is used) ──────
# Data API v3 key adds durations, >15 videos, and subscriber count.
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=UCOQihhIzR63mQL3PT1PI-pQ

# ─── Enquiry form delivery (configure at least one) ────────────────────
# Resend: emails each enquiry to ENQUIRY_TO_EMAIL.
RESEND_API_KEY=
RESEND_FROM="Pooja Dugar Studio <hello@your-domain.com>"
ENQUIRY_TO_EMAIL=poojadugar.pd@gmail.com
# Formspree: https://formspree.io/f/xxxxxxx
FORMSPREE_ENDPOINT=
# Google Sheets: Apps Script web-app URL that appends the JSON body as a row.
GOOGLE_SHEETS_WEBHOOK_URL=
