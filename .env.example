# ─────────────────────────────────────────────────────────────────────────────
# PoojaEdit.com — environment template
#
# Copy to `.env.local` for development. NEVER commit a filled-in copy.
# Server vs public split and validation live in src/lib/env.ts / src/lib/public-env.ts.
# Only NEXT_PUBLIC_* values reach the browser.
# Preview/dev must use TEST credentials only — live keys are rejected at boot.
# ─────────────────────────────────────────────────────────────────────────────

# ── Site ────────────────────────────────────────────────────────────────────
# Absolute base URL of this deployment.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Optional explicit deployment identity. Normally derived from VERCEL_ENV;
# defaults to "development" everywhere else (incl. local/CI production builds).
# One of: development | preview | production
# NEXT_PUBLIC_APP_ENV=

# ── Supabase (Auth + Storage) — see docs/supabase-setup.md ─────────────────
# Leave blank to run locally without Supabase (auth features are then inert).
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
# Server-only. Only set if a flow genuinely needs the service key.
SUPABASE_SECRET_KEY=""
# Secret required to create the first OWNER admin (one-time). Rotate/remove after.
ADMIN_BOOTSTRAP_TOKEN=""

# ── Database (Prisma 7) ────────────────────────────────────────────────────
# Local dev: run `npm run db:dev` (embedded PostgreSQL, no account) — it prints:
#   DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5433/poojaedit_dev"
#   DIRECT_URL="postgresql://postgres:postgres@127.0.0.1:5433/poojaedit_dev"
#   SHADOW_DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5433/poojaedit_shadow"
# Production (Supabase): DATABASE_URL = Supavisor transaction pooler (port 6543,
# ?pgbouncer=true) for the runtime client; DIRECT_URL = session mode (port 5432)
# or a direct connection for the Prisma CLI / migrations.
DATABASE_URL=""
DIRECT_URL=""
SHADOW_DATABASE_URL=""

# ── Razorpay — wired in Phase 7 (TEST keys only outside production) ──────────
# All three must be set for prepaid checkout to run; otherwise the UI shows
# "online payment unavailable" and only COD works. Register the webhook URL
# <site>/api/webhooks/razorpay with events payment.authorized / payment.captured
# / payment.failed / refund.processed / refund.failed and use its signing secret
# as RAZORPAY_WEBHOOK_SECRET.
NEXT_PUBLIC_RAZORPAY_KEY_ID=""     # rzp_test_… (browser-exposed key id)
RAZORPAY_KEY_SECRET=""            # server-only; pairs with the key id for Basic auth
RAZORPAY_WEBHOOK_SECRET=""        # server-only; the webhook endpoint's signing secret

# ── Shadowfax — wired in Phase 8 (master v1.1; single last-mile carrier) ────
# API_TOKEN + CLIENT_ID both required for fulfilment; otherwise checkout still
# prices via the deterministic test adapter and no shipments are created.
# WEBHOOK_TOKEN is whatever static token the account's callback config supports
# (may be empty — callback auth is weak by design; the service re-verifies every
# status change against the authenticated tracking API).
SHADOWFAX_API_TOKEN=""
SHADOWFAX_CLIENT_ID=""
SHADOWFAX_WEBHOOK_TOKEN=""
SHADOWFAX_API_BASE=""            # optional; default https://api.shadowfax.in

# ── WhatsApp (Meta Cloud API) — wired in Phase 10 ──────────────────────────
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_VERIFY_TOKEN=""
META_APP_SECRET=""

# ── Email (Resend) — wired in Phase 10 ────────────────────────────────────
# API_KEY + EMAIL_FROM (verified sender) enable outbound email; without them the
# email channel records deliveries as skipped/failed and never blocks an order.
# WEBHOOK_SECRET is the Svix `whsec_…` secret from the Resend webhook endpoint —
# required for /api/webhooks/resend to accept delivery-status callbacks.
RESEND_API_KEY=""
EMAIL_FROM=""              # e.g. "The Pooja Edit <orders@thepoojaedit.in>"
RESEND_WEBHOOK_SECRET=""   # whsec_… (Svix)

# ── Background jobs (Inngest) — wired in Phase 6 ──────────────────────────
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""

# ── Instagram strip (Behold.so) — optional ──────────────────────────────
# Behold.so feed id — connect @poojadugar_ once at behold.so, paste the id from
# feeds.behold.so/<id>. Unset ⇒ the homepage shows a curated product strip.
BEHOLD_FEED_ID=""

# ── Monitoring ───────────────────────────────────────────────────────────
SENTRY_DSN=""
# SENTRY_ENVIRONMENT must NOT be "production" outside a production deploy.
# SENTRY_ENVIRONMENT=
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL="info"
# Set to 1 for human-readable local logs.
# LOG_PRETTY=1

# ── Business configuration (owner-confirmed before live checkout/invoices) ──
# Non-secret settings will move into the StoreSettings table; kept here only
# until that table exists (Phase 2+). Do not invent these values.
# BUSINESS_LEGAL_NAME=
# BUSINESS_GSTIN=
# BUSINESS_STATE_CODE=
# INVOICE_SERIES=
