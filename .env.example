# ─────────────────────────────────────────────────────────────────────────────
# PoojaEdit.com — environment template
#
# Copy to `.env.local` for development. NEVER commit a filled-in copy.
# Server vs public split and validation live in src/lib/env.ts / src/lib/public-env.ts.
# Only NEXT_PUBLIC_* values reach the browser.
# Preview/dev must use TEST credentials only — live keys are rejected at boot.
# ─────────────────────────────────────────────────────────────────────────────

# ── Site ────────────────────────────────────────────────────────────────────
# Absolute base URL of this deployment.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Optional explicit deployment identity. Normally derived from VERCEL_ENV;
# defaults to "development" everywhere else (incl. local/CI production builds).
# One of: development | preview | production
# NEXT_PUBLIC_APP_ENV=

# ── Supabase (Auth + Storage) — see docs/supabase-setup.md ─────────────────
# Leave blank to run locally without Supabase (auth features are then inert).
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
# Server-only. Only set if a flow genuinely needs the service key.
SUPABASE_SECRET_KEY=""
# Secret required to create the first OWNER admin (one-time). Rotate/remove after.
ADMIN_BOOTSTRAP_TOKEN=""

# ── Database (Prisma 7) ────────────────────────────────────────────────────
# Local dev: run `npm run db:dev` (embedded PostgreSQL, no account) — it prints:
#   DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5433/poojaedit_dev"
#   DIRECT_URL="postgresql://postgres:postgres@127.0.0.1:5433/poojaedit_dev"
#   SHADOW_DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5433/poojaedit_shadow"
# Production (Supabase): DATABASE_URL = Supavisor transaction pooler (port 6543,
# ?pgbouncer=true) for the runtime client; DIRECT_URL = session mode (port 5432)
# or a direct connection for the Prisma CLI / migrations.
DATABASE_URL=""
DIRECT_URL=""
SHADOW_DATABASE_URL=""

# ── Razorpay — wired in Phase 7 (TEST keys only outside production) ──────────
NEXT_PUBLIC_RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# ── Shiprocket — wired in Phase 8 ──────────────────────────────────────────
SHIPROCKET_EMAIL=""
SHIPROCKET_PASSWORD=""

# ── WhatsApp (Meta Cloud API) — wired in Phase 10 ──────────────────────────
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_VERIFY_TOKEN=""
META_APP_SECRET=""

# ── Email (Resend) — wired in Phase 10 ────────────────────────────────────
RESEND_API_KEY=""
EMAIL_FROM=""

# ── Background jobs (Inngest) — wired in Phase 6 ──────────────────────────
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""

# ── Monitoring ───────────────────────────────────────────────────────────
SENTRY_DSN=""
# SENTRY_ENVIRONMENT must NOT be "production" outside a production deploy.
# SENTRY_ENVIRONMENT=
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL="info"
# Set to 1 for human-readable local logs.
# LOG_PRETTY=1

# ── Business configuration (owner-confirmed before live checkout/invoices) ──
# Non-secret settings will move into the StoreSettings table; kept here only
# until that table exists (Phase 2+). Do not invent these values.
# BUSINESS_LEGAL_NAME=
# BUSINESS_GSTIN=
# BUSINESS_STATE_CODE=
# INVOICE_SERIES=
