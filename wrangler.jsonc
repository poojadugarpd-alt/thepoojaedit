{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pooja-dugar-studio",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": { "enabled": true },
  "kv_namespaces": [
    // ISR / fetch cache (YouTube + Instagram data refresh hourly)
    { "binding": "NEXT_INC_CACHE_KV", "id": "410a3ae7fb974153a2d1bfb785ff6d13" }
  ],
  "services": [
    // Lets the worker call itself to revalidate pages in the background
    { "binding": "WORKER_SELF_REFERENCE", "service": "pooja-dugar-studio" }
  ]
}
